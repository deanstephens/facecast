/* Facecast's in-world overlay: names over heads, the crosshair, the controls hint and the offline banner. Matches the
   page around the web build (WebGLTemplates/Facecast): deep navy glass, cream text, each player's own colour. */

:root {
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/FiraSans-SemiBold-SDF.asset");
    color: rgb(255, 250, 240);
    font-size: 20px;
}

.fc-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.fc-plates {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.fc-plate {
    position: absolute;
    translate: -50% -100%;
    transform-origin: 50% 100%;
    padding: 3px 12px 4px 12px;
    border-radius: 12px;
    background-color: rgba(18, 24, 44, 0.72);
    border-bottom-width: 3px;
    font-size: 22px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.fc-plate--speaking {
    background-color: rgba(34, 48, 92, 0.92);
}

.fc-crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    translate: -50% -50%;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.85);
    border-width: 1.5px;
    border-color: rgba(18, 24, 44, 0.55);
}

.fc-hint {
    position: absolute;
    left: 50%;
    bottom: 34px;
    translate: -50% 0;
    padding: 9px 20px 10px 20px;
    border-radius: 20px;
    background-color: rgba(18, 24, 44, 0.74);
    font-size: 19px;
    white-space: nowrap;
}

.fc-banner {
    position: absolute;
    left: 50%;
    top: 22px;
    translate: -50% 0;
    padding: 7px 18px 8px 18px;
    border-radius: 16px;
    background-color: rgba(242, 193, 78, 0.92);
    color: rgb(40, 30, 10);
    font-size: 18px;
    white-space: nowrap;
}

/* What a click would do: under the crosshair. */
.fc-prompt {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% 26px;
    padding: 5px 14px 6px 14px;
    border-radius: 14px;
    background-color: rgba(18, 24, 44, 0.66);
    font-size: 18px;
    white-space: nowrap;
}

/* The note to write on, when there's no page around the game (the Editor, desktop builds). */
.fc-editor {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(18, 24, 44, 0.35);
}

.fc-editor-card {
    width: 400px;
    align-items: center;
}

.fc-note {
    width: 380px;
    height: 380px;
    padding: 28px 26px 22px 26px;
    rotate: -1.5deg;
    border-bottom-width: 6px;
    border-bottom-color: rgba(0, 0, 0, 0.12);
}

/* A question card: cream, shorter, with a red rule across the top. */
.fc-note--card {
    height: 266px;
    padding-top: 46px;
    background-color: rgb(251, 246, 232);
}

.fc-note-rule {
    display: none;
    position: absolute;
    left: 14px;
    right: 14px;
    top: 34px;
    height: 3px;
    background-color: rgb(224, 103, 95);
}

.fc-note--card > .fc-note-rule {
    display: flex;
}

.fc-note-text {
    flex-grow: 1;
    margin: 0;
    font-size: 36px;
    color: rgb(38, 48, 90);
    -unity-text-align: middle-center;
    white-space: normal;
}

.fc-note-text > .unity-text-field__input {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.fc-note-count {
    position: absolute;
    right: 14px;
    bottom: 8px;
    font-size: 15px;
    color: rgba(38, 48, 90, 0.55);
}

.fc-note-swatches {
    flex-direction: row;
    margin-top: 18px;
}

.fc-note-swatch {
    width: 34px;
    height: 34px;
    margin: 0 6px 0 6px;
    border-radius: 7px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

.fc-note-swatch--on {
    border-color: rgb(29, 36, 64);
}

.fc-note-actions {
    flex-direction: row;
    margin-top: 16px;
}

.fc-button {
    margin: 0 6px 0 6px;
    padding: 9px 22px 10px 22px;
    border-radius: 16px;
    border-width: 0;
    background-color: rgba(18, 24, 44, 0.74);
    color: rgb(255, 250, 240);
    font-size: 19px;
}

.fc-button:hover {
    background-color: rgba(28, 36, 64, 0.92);
}

.fc-button--primary {
    background-color: rgb(29, 36, 64);
}

.fc-note-tip {
    margin-top: 12px;
    font-size: 15px;
    color: rgb(255, 250, 240);
    -unity-text-align: middle-center;
}
